{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Donut chart showing male vs female student counts for the selected state (2024).",
  "title": {
    "signal": "'2024 Student Gender Mix (' + selectedState + ')'"
  },
  "width": 320,
  "height": 320,
  "background": "#ffffff",
  "data": {
    "url": "data/Australia_states_data/student_counts_processed.json"
  },
  "params": [
    {
      "name": "selectedState",
      "value": "New South Wales"
    }
  ],
  "transform": [
    {
      "filter": "datum.Year == 2024"
    },
    {
      "filter": "datum.State == selectedState"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Students",
          "as": "Students"
        }
      ],
      "groupby": [
        "Gender"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "Students",
          "as": "Total"
        }
      ]
    },
    {
      "calculate": "datum.Students / datum.Total",
      "as": "Share"
    }
  ],
  "mark": {
    "type": "arc",
    "outerRadius": 150,
    "innerRadius": 60
  },
  "encoding": {
    "theta": {
      "field": "Students",
      "type": "quantitative"
    },
    "color": {
      "field": "Gender",
      "type": "nominal",
      "scale": {
        "domain": [
          "Male",
          "Female"
        ],
        "range": [
          "#3772ff",
          "#f472b6"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "title": "Gender"
      }
    },
    "tooltip": [
      {
        "field": "Gender",
        "type": "nominal",
        "title": "Gender"
      },
      {
        "field": "Students",
        "type": "quantitative",
        "title": "Students",
        "format": ","
      },
      {
        "field": "Share",
        "type": "quantitative",
        "title": "Share",
        "format": ".1%"
      }
    ]
  },
  "config": {
    "legend": {
      "orient": "bottom",
      "direction": "horizontal"
    }
  }
}