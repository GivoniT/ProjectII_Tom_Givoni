{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Victorian schools coloured by Median VCE with SA2 average ICSEA backdrop.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "width": "container",
  "height": 500,
  "background": "#f5f7fa",
  "padding": {
    "top": 12,
    "right": 12,
    "bottom": 20,
    "left": 12
  },
  "params": [
    {
      "name": "zoom",
      "value": 11000,
      "bind": {
        "input": "range",
        "min": 4000,
        "max": 50000,
        "step": 250
      }
    },
    {
      "name": "scoreMin",
      "value": 20
    },
    {
      "name": "scoreMax",
      "value": 50
    },
    {
      "name": "selectedSchools",
      "value": []
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [
      145.0,
      -37.8
    ],
    "scale": {
      "expr": "zoom"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/Improved_map/map2.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f5e3c9",
        "stroke": "#333333",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/Improved_map/map2.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties && datum.properties['SA2_NAME16'] ? datum.properties['SA2_NAME16'] : datum.properties && datum.properties['SA2_NAME'] ? datum.properties['SA2_NAME'] : 'Unknown Region'",
          "as": "map2_region"
        },
        {
          "calculate": "datum.properties && datum.properties['median_income'] != null ? toNumber(datum.properties['median_income']) : null",
          "as": "median_income_value"
        },
        {
          "calculate": "isValid(datum.median_income_value) ? datum.median_income_value : 500",
          "as": "median_income_color"
        },
        {
          "calculate": "isValid(datum.median_income_value) ? format(datum.median_income_value, '.0f') : 'Unavailable'",
          "as": "median_income_label"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#333333",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "field": "median_income_color",
          "type": "quantitative",
          "title": "Median Weekly Income",
          "scale": {
            "scheme": "blues"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Median Weekly Income",
            "offset": 14
          }
        },
        "tooltip": [
          {
            "field": "map2_region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "median_income_label",
            "type": "nominal",
            "title": "Median Weekly Income"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/combined_df.csv"
      },
      "transform": [
        {
          "filter": "datum.State == 'VIC'"
        },
        {
          "calculate": "datum.Latitude === null || datum.Latitude === '' || datum.Latitude === '-' ? null : toNumber(datum.Latitude)",
          "as": "lat"
        },
        {
          "calculate": "datum.Longitude === null || datum.Longitude === '' || datum.Longitude === '-' ? null : toNumber(datum.Longitude)",
          "as": "lon"
        },
        {
          "calculate": "datum['Median VCE study score'] === null || datum['Median VCE study score'] === '' || datum['Median VCE study score'] === '-' ? null : toNumber(datum['Median VCE study score'])",
          "as": "vce_score"
        },
        {
          "filter": "isFinite(datum.lat) && isFinite(datum.lon) && isFinite(datum.vce_score)"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 70,
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "vce_score",
          "type": "quantitative",
          "title": "Median VCE Score",
          "scale": {
            "scheme": "orangered"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Median VCE Score",
            "offset": 36
          }
        },
        "opacity": {
          "condition": [
            {
              "test": "selectedSchools.length && indexof(selectedSchools, datum['School Name']) >= 0",
              "value": 1
            },
            {
              "test": "datum.vce_score >= scoreMin && datum.vce_score <= scoreMax",
              "value": 0.9
            }
          ],
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "School Name",
            "type": "nominal",
            "title": "School"
          },
          {
            "field": "Suburb",
            "type": "nominal",
            "title": "Suburb"
          },
          {
            "field": "vce_score",
            "type": "quantitative",
            "title": "Median VCE",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
